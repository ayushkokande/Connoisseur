<%- include("../partials/header") %>

<div class="container">
	<header class="jumbotron py-4">
		<h1>Welcome to Connoisseur!</h1>
		<p>Browse restaurants reviewed by our community, or add your own.</p>
		<a class="btn btn-primary btn-lg" href="/restaurants/new">Add New Restaurant</a>
	</header>

	<div class="row">
		<% if (restaurants.length === 0) { %>
			<div class="col-12"><p class="text-muted">No restaurants yet. Be the first to add one!</p></div>
		<% } %>
		<% restaurants.forEach((restaurant) => { %>
			<div class="col-md-4 col-sm-6 mb-4">
				<div class="card h-100">
					<img class="card-img-top restaurant-thumb" src="<%= restaurant.image %>" alt="<%= restaurant.name %>">
					<div class="card-body d-flex flex-column">
						<h5 class="card-title"><%= restaurant.name %></h5>
						<p class="card-text text-muted mb-2">
							<%= restaurant.cuisine %> &middot; <%= restaurant.priceRange %>
						</p>
						<a href="/restaurants/<%= restaurant._id %>" class="btn btn-outline-primary mt-auto">More Info</a>
					</div>
				</div>
			</div>
		<% }); %>
	</div>
</div>

<%- include("../partials/footer") %>
