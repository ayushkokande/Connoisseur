<%- include("../partials/header") %>

<div class="container">
	<div class="row">
		<div class="col-md-3">
			<div class="list-group mb-4">
				<span class="list-group-item active">Connoisseur</span>
				<a href="/restaurants" class="list-group-item list-group-item-action">All Restaurants</a>
			</div>
		</div>
		<div class="col-md-9">
			<div class="card mb-4">
				<img class="card-img-top" src="<%= restaurant.image %>" alt="<%= restaurant.name %>">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-start">
						<h3 class="card-title"><%= restaurant.name %></h3>
						<span class="text-muted h5"><%= restaurant.priceRange %></span>
					</div>
					<p class="text-muted mb-2"><%= restaurant.cuisine %></p>
					<p class="card-text"><%= restaurant.description %></p>
					<p class="text-muted">
						<em>Added by <%= restaurant.author.username %>, <%= moment(restaurant.createdAt).fromNow() %></em>
					</p>
					<% if (currentUser && restaurant.author.id.equals(currentUser._id)) { %>
						<a class="btn btn-sm btn-warning" href="/restaurants/<%= restaurant._id %>/edit">Edit</a>
						<form class="d-inline" action="/restaurants/<%= restaurant._id %>?_method=DELETE" method="POST">
							<button class="btn btn-sm btn-danger" type="submit">Delete</button>
						</form>
					<% } %>
				</div>
			</div>

			<div class="card">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<h4 class="mb-0">Reviews</h4>
						<a class="btn btn-success" href="/restaurants/<%= restaurant._id %>/comments/new">Add Review</a>
					</div>
					<hr>
					<% if (restaurant.comments.length === 0) { %>
						<p class="text-muted">No reviews yet. Be the first to review this restaurant!</p>
					<% } %>
					<% restaurant.comments.forEach((comment) => { %>
						<div class="mb-3">
							<div class="d-flex justify-content-between">
								<strong><%= comment.author.username %></strong>
								<span class="text-muted"><%= moment(comment.createdAt).fromNow() %></span>
							</div>
							<p class="mb-1"><%= comment.text %></p>
							<% if (currentUser && comment.author.id.equals(currentUser._id)) { %>
								<a class="btn btn-sm btn-outline-warning" href="/restaurants/<%= restaurant._id %>/comments/<%= comment._id %>/edit">Edit</a>
								<form class="d-inline" action="/restaurants/<%= restaurant._id %>/comments/<%= comment._id %>?_method=DELETE" method="POST">
									<button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
								</form>
							<% } %>
							<hr>
						</div>
					<% }); %>
				</div>
			</div>
		</div>
	</div>
</div>

<%- include("../partials/footer") %>
