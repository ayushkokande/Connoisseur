<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Connoisseur - Restaurant Reviews</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
	<link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
	<nav class="navbar navbar-expand-md navbar-dark bg-dark">
		<div class="container">
			<a class="navbar-brand" href="/">🍽️ Connoisseur</a>
			<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav mr-auto">
					<li class="nav-item"><a class="nav-link" href="/restaurants">Restaurants</a></li>
				</ul>
				<ul class="navbar-nav ml-auto">
					<% if (!currentUser) { %>
						<li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
						<li class="nav-item"><a class="nav-link" href="/register">Sign Up</a></li>
					<% } else { %>
						<li class="nav-item"><span class="navbar-text mr-3">Signed in as <strong><%= currentUser.username %></strong></span></li>
						<li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
					<% } %>
				</ul>
			</div>
		</div>
	</nav>

	<div class="container mt-3">
		<% if (flashErrorMessage && flashErrorMessage.length > 0) { %>
			<div class="alert alert-danger" role="alert"><%= flashErrorMessage %></div>
		<% } %>
		<% if (flashSuccessMessage && flashSuccessMessage.length > 0) { %>
			<div class="alert alert-success" role="alert"><%= flashSuccessMessage %></div>
		<% } %>
	</div>
