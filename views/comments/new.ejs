<%- include("../partials/header") %>

<div class="container">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<h1 class="text-center my-4">Review <%= restaurant.name %></h1>
			<form action="/restaurants/<%= restaurant._id %>/comments" method="POST">
				<div class="form-group">
					<label for="text">Your Review</label>
					<textarea class="form-control" id="text" name="text" rows="4" placeholder="How was your experience?" required></textarea>
				</div>
				<button class="btn btn-success btn-block" type="submit">Submit Review</button>
			</form>
			<a href="/restaurants/<%= restaurant._id %>" class="d-block text-center mt-3">Go Back</a>
		</div>
	</div>
</div>

<%- include("../partials/footer") %>
